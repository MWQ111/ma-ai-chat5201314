# ============================================================
# 环境变量模板：复制为 .env 后填入实际值
#   cp .env.example .env
# Docker 部署：docker-compose 会自动读取 .env 中的变量
# 本地开发：应用启动时也会自动加载 .env（无需手动 set）
# ============================================================

# ---------- API 密钥 ----------
# DeepSeek 对话模型（必填；也可留空，启动后在界面「API配置」中填写）
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# OpenAI 密钥（可选）：RAG / 语义缓存的回退嵌入源
# Ollama 不可用（服务未启动等）时才使用 text-embedding-3-small；留空则回退本地内置模型
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 嵌入方式：auto=优先 Ollama bge-m3，不可用时回退 OpenAI / 本地内置模型
# 也可强制指定 ollama / openai / local
EMBEDDING_PROVIDER=auto

# Ollama 嵌入模型名（多语言，中文语义区分度优于英文模型；默认 bge-m3）
# 使用前请先启动 Ollama 并执行：ollama pull bge-m3
OLLAMA_EMBEDDING_MODEL=bge-m3

# Ollama 本地模型服务地址（界面切换「Ollama」提供方时使用）
# 本地开发默认 http://localhost:11434/v1；
# Docker 部署访问宿主机 Ollama 时改为 http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Tavily 网络搜索密钥（Function Calling 的「网络搜索」工具使用）
# 前往 https://tavily.com 注册获取（免费额度每月 1000 次）
TAVILY_API_KEY=

# pixserp 备用搜索密钥（可选）：Tavily 调用失败（超时/额度/错误）时自动切换
# 前往 https://pixserp.com/api-keys 注册获取；留空则 Tavily 失败时直接报错
PIXSERP_API_KEY=

# ---------- MySQL 数据库 ----------
# 数据库连接串（SQLAlchemy 格式，含账号密码）。应用启动时自动建表
# （conversations / messages），但不会自动建库：请先手动创建数据库 ma_ai_chat。
# 未配置时使用内置的本地开发默认值（root:123456@localhost:3306/ma_ai_chat）；
# 本机密码不同时务必在此配置，否则应用会静默降级到本地 JSON 存储。
DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3306/ma_ai_chat

# ---------- Agent（LangGraph） ----------
# Agent 模式默认最大规划步数（界面侧边栏可再调整，范围 1-10）
AGENT_MAX_STEPS=5

# ---------- Redis 缓存 ----------
# Docker 部署时无需修改（compose 自动指向 redis 服务）
# 本地开发时如需修改，请设置 REDIS_HOST/REDIS_PORT/REDIS_PASSWORD
CACHE_TTL=3600

# ---------- 端口 ----------
# 应用对外端口（Docker 部署）
PORT=8501
